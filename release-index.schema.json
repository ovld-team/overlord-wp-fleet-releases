{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Overlord WP Fleet release index",
  "type": "object",
  "required": ["schema", "slug", "version", "zip_url", "sha256", "size", "requires_php", "requires_wp", "signatures"],
  "properties": {
    "schema": { "const": 1 },
    "slug": { "const": "overlord-wp-fleet" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "zip_url": { "type": "string", "description": "Must equal https://github.com/ovld-team/overlord-wp-fleet-releases/releases/download/v{version}/overlord-wp-fleet-{version}.zip" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "size": { "type": "integer", "minimum": 1, "maximum": 67108864 },
    "requires_php": { "type": "string", "pattern": "^\\d+(\\.\\d+){0,2}$" },
    "requires_wp": { "type": "string", "pattern": "^\\d+(\\.\\d+){0,2}$" },
    "tested_wp": { "type": "string" },
    "released_at": { "type": "string", "format": "date-time" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "changelog": { "type": "string", "maxLength": 4000 },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["key_id", "sig"],
        "properties": {
          "key_id": { "type": "string", "pattern": "^[a-z0-9-]{3,32}$" },
          "sig": { "type": "string", "description": "Standard base64 of 64 bytes (Ed25519 over the OVP2-RELEASE message)" }
        }
      }
    }
  },
  "additionalProperties": true
}
